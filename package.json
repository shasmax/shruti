{
  "name": "shruti",
  "version": "0.2.1",
  "description": "Meeting agent: joins Zoom/Meet, records, diarizes, turns speech into spec.json for ERP•AI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "shruti": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "GOALS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p . && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "tsc -p . --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "meeting-bot",
    "transcription",
    "ai-agents",
    "claude",
    "erp",
    "zoom",
    "google-meet",
    "recall-ai"
  ],
  "homepage": "https://github.com/erphq/shruti",
  "repository": {
    "type": "git",
    "url": "https://github.com/erphq/shruti.git"
  },
  "bugs": {
    "url": "https://github.com/erphq/shruti/issues"
  }
}
